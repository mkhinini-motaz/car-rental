# Copy to .env. Compose reads it for ${VAR} substitution in the compose files and for COMPOSE_FILE.

# Which overlay runs on this machine.
COMPOSE_FILE=compose.yml:compose.local.yml
# On the server:
# COMPOSE_FILE=compose.yml:compose.prod.yml

# Image naming. Locally the images are built from the sibling repos and tagged like this; on the
# server IMAGE_PREFIX is the registry the build workflows push to and TAG is the version to run.
IMAGE_PREFIX=carrental/
TAG=local

# Public hostname. The apex is the web app, api. is carapi. Browsers resolve anything under
# .localhost to this machine with no setup.
DOMAIN=car.localhost
# On the server: the domain in terraform/terraform.tfvars

# Local only: the scheme baked into the web bundle's API URL at build time (compose.local.yml).
WEB_SCHEME=http

# Server only: Let's Encrypt registers the certificates to this address.
ACME_EMAIL=
