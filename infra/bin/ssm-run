#!/bin/sh
# Run a shell command on the server through SSM Run Command and print its output. Used by the
# deploy workflow so that GitHub never holds an SSH key and the instance never opens port 22.
#   INSTANCE_ID=i-... [AWS_REGION=eu-west-3] bin/ssm-run 'cd /srv/carrental && make deploy'
# Exits with the command's status. Waits up to 20 minutes (a first deploy pulls both images).
set -eu
[ $# -eq 1 ] || { echo "usage: bin/ssm-run '<shell command>'" >&2; exit 2; }
: "${INSTANCE_ID:?set INSTANCE_ID (tofu output -raw instance_id)}"
export AWS_REGION="${AWS_REGION:-eu-west-3}"

# The command goes through JSON, so pass it as a parameter file rather than escaping by hand.
params=$(mktemp)
trap 'rm -f "$params"' EXIT
printf '{"commands":[%s],"executionTimeout":["1200"]}' "$(printf '%s' "$1" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))')" > "$params"

id=$(aws ssm send-command \
  --instance-ids "$INSTANCE_ID" \
  --document-name AWS-RunShellScript \
  --comment "car-infra: $(printf '%s' "$1" | cut -c1-80)" \
  --parameters "file://$params" \
  --query Command.CommandId --output text)

status=InProgress
i=0
while [ "$status" = InProgress ] || [ "$status" = Pending ] || [ "$status" = Delayed ]; do
  i=$((i + 1)); [ $i -le 240 ] || { echo "timed out after 20 minutes (command $id)" >&2; exit 1; }
  sleep 5
  status=$(aws ssm get-command-invocation --command-id "$id" --instance-id "$INSTANCE_ID" \
    --query Status --output text 2>/dev/null || echo Pending)
done

aws ssm get-command-invocation --command-id "$id" --instance-id "$INSTANCE_ID" \
  --query '[StandardOutputContent, StandardErrorContent]' --output text
[ "$status" = Success ] || { echo "command $id finished with status $status" >&2; exit 1; }
