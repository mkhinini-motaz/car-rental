# carapi on the server. Copy to env/api.env in /srv/carrental and replace every <...>.
# The values marked tofu come from `tofu output -raw <name>` in car-infra/terraform on the laptop;
# APP_KEY and JWT_SECRET from `make keys` on the laptop. LOG_CHANNEL is set by compose.
APP_NAME="Car rental"
APP_ENV=production
APP_KEY=<make keys>
APP_DEBUG=false
APP_URL=https://api.<domain>

DB_CONNECTION=mysql
DB_HOST=<tofu db_endpoint>
DB_PORT=3306
DB_DATABASE=carrental
DB_USERNAME=carrental
DB_PASSWORD=<tofu db_password>

# Load-bearing: shared by the api and the scheduler (JWT blacklist, throttles). See api.env.example.
CACHE_STORE=database
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

JWT_SECRET=<make keys>

# With the Firebase service-account key at secrets/fcm.json. Leave empty to only log pushes.
FCM_CREDENTIALS=/run/secrets/fcm_key

# SMS codes (password reset, invitations, agency sign-up). log: none, the codes only go to the
# api's log. winsms or orange: set SMS_API_KEY (Orange: the app's "Basic ..." authorization header)
# and SMS_SENDER, the sender name registered with the gateway. Any other gateway: SMS_DRIVER=http
# with SMS_URL (and SMS_BODY for a JSON POST); see carapi's config/services.php.
SMS_DRIVER=log
SMS_API_KEY=
SMS_SENDER=
