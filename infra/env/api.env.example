# carapi configuration for the local stack. Copy to env/api.env (make init does). The comment on a
# line says what changes on the server; env/api.env.production.example is the server's version.
# LOG_CHANNEL is set by compose.
APP_NAME="Car rental"
APP_ENV=local                          # production
APP_KEY=                               # make keys
APP_DEBUG=true                         # false
APP_URL=http://api.car.localhost       # https://api.<domain>

DB_CONNECTION=mysql
DB_HOST=mysql                          # the RDS endpoint (tofu output db_endpoint)
DB_PORT=3306
DB_DATABASE=carrental
DB_USERNAME=carrental                  # must match env/mysql.env locally
DB_PASSWORD=carrental

# Load-bearing, not a performance choice: the api and the scheduler are two containers, so the
# cache must be shared. It holds the JWT blacklist (logout), the login/code/reset throttles and the
# one-SMS-a-minute limit; a file cache would enforce each of them on one container only.
CACHE_STORE=database
SESSION_DRIVER=array
QUEUE_CONNECTION=sync                  # carapi queues nothing; no worker runs
FILESYSTEM_DISK=local                  # the private disk on the api_files volume

JWT_SECRET=                            # make keys

# Push notifications. Empty: every push is only logged. On the server, with the real key at
# secrets/fcm.json: /run/secrets/fcm_key
FCM_CREDENTIALS=

# SMS codes (password reset, invitations, agency sign-up). log: none, the codes only go to the
# api's log. winsms or orange: set SMS_API_KEY (Orange: the app's "Basic ..." authorization header)
# and SMS_SENDER, the sender name registered with the gateway. Any other gateway: SMS_DRIVER=http
# with SMS_URL (and SMS_BODY for a JSON POST); see carapi's config/services.php.
SMS_DRIVER=log
SMS_API_KEY=
SMS_SENDER=
